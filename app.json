{
  "expo": {
    "name": "GLYSE",
    "slug": "glyse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/assety.png",
    "scheme": "glyse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003355",
        "foregroundImage": "./assets/assety.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/assety.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/assety.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#003355",
          "dark": {
            "backgroundColor": "#003355"
          }
        }
      ],
      "expo-asset"
    ]
  }
}
